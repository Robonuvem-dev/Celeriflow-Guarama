  requester   Employee @relation("EmployeePurchaseRequests", fields: [requesterId], references: [id])

  approvedByEmployeeId String?
  approvedByEmployee   Employee? @relation("PurchaseRequestApprover", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  approvedAt           DateTime?

  items             PurchaseRequestItem[]
  purchaseProcesses PurchaseProcess[]              @relation("PurchaseRequestProcesses")
  processOrigins    PurchaseProcessRequestOrigin[] @relation("PurchaseProcessRequestOriginRequest")
  purchasePlannings PurchasePlanning[]             @relation("PurchasePlanningOriginRequest")
  obrasServiceLinks ObrasServicoCompra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseRequestItem {
  id                 String          @id @default(cuid())
  purchaseRequestId  String
  purchaseRequest    PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  catalogItemId      String?
  catalogItem        CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  customName         String?
  quantity           Float
  estimatedUnitValue Float?

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  budgetAllocations  PurchaseRequestItemBudgetAllocation[]
  processItemOrigins PurchaseProcessItemOrigin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A future need is deliberately separate from requests and processes. It can
// reference either one without reserving budget or creating a procurement flow.
model PurchasePlanning {
  id                      String           @id @default(cuid())
  description             String?
  catalogItemId           String?
  catalogItem             CatalogItem?     @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  originPurchaseRequestId String?
  originPurchaseRequest   PurchaseRequest? @relation("PurchasePlanningOriginRequest", fields: [originPurchaseRequestId], references: [id], onDelete: Restrict)
  unit                    String
  quantity                Float
  expectedPeriodStart     DateTime         @db.Date
  expectedPeriodEnd       DateTime         @db.Date
  estimatedValueDecimal   Decimal          @db.Decimal(18, 2)
  status                  String           @default("Rascunho")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([status, expectedPeriodStart])
  @@index([catalogItemId])
  @@index([originPurchaseRequestId])
}

model PurchaseProcess {
  id             String  @id @default(cuid())
  number         String  @unique
  object         String
  type           String // Comum, Registro de PreÃ§os
  modality       String? // PregÃ£o, ConcorrÃªncia, Dispensa, Inexigibilidade
  estimatedValue Float?
  status         String  @default("Em Planejamento")

  secretariatId String
  secretariat   Secretariat @relation("SecretariatPurchaseProcesses", fields: [secretariatId], references: [id])

  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation("PurchaseRequestProcesses", fields: [purchaseRequestId], references: [id], onDelete: Restrict)

  preliminaryStudies PreliminaryTechnicalStudy[]
  termsOfReference   TermOfReference[]
  priceResearches    PriceResearch[]
  biddings           Bidding[]
  directContractings DirectContracting[]
  contracts          Contract[]
  receipts           PurchaseReceipt[]
  commitments        Commitment[]                @relation("ProcurementProcessCommitments")

  items             PurchaseProcessItem[]
  requestOrigins    PurchaseProcessRequestOrigin[] @relation("PurchaseProcessRequestOriginProcess")
  obrasServiceLinks ObrasServicoCompra[]
  culturaProjects   CulturaProjeto[]               @relation("CulturaProjectPurchase")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseProcessItem {
  id                 String          @id @default(cuid())
  purchaseProcessId  String
  purchaseProcess    PurchaseProcess @relation(fields: [purchaseProcessId], references: [id], onDelete: Cascade)
  catalogItemId      String?
  catalogItem        CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  customName         String?
  quantity           Float
  estimatedUnitValue Float?

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  receiptItems               PurchaseReceiptItem[]
  requestItemOrigins         PurchaseProcessItemOrigin[]
  biddingLotItems            BiddingLotItem[]
  instrumentMeasurementItems InstrumentMeasurementItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PreliminaryTechnicalStudy {
  id             String @id @default(cuid())
  description    String
  justification  String
  estimatedValue Float?
  status         String @default("Em ElaboraÃ§Ã£o") // Em ElaboraÃ§Ã£o, Aprovado

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  biddingAppointmentAssignments BiddingAppointmentAssignment[]
  biddingPhases                 BiddingPhase[]
  biddingActs                   BiddingAct[]
  biddingParticipants           BiddingParticipant[]
  biddingLots                   BiddingLot[]
}

model TermOfReference {
  id             String @id @default(cuid())
  object         String
  justification  String
  scope          String
  estimatedValue Float?
  status         String @default("Em ElaboraÃ§Ã£o") // Em ElaboraÃ§Ã£o, Aprovado

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceResearch {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  estimatedValue Float?
  status         String   @default("Em Andamento") // Em Andamento, ConcluÃ­da

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  quotes PriceQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceQuote {
  id     String   @id @default(cuid())
  value  Float
  date   DateTime @default(now())
  status String   @default("Ativa")

  researchId String
  research   PriceResearch @relation(fields: [researchId], references: [id])

  supplierId String
  supplier   Supplier @relation("SupplierPriceQuotes", fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bidding {
  id              String    @id @default(cuid())
  number          String    @unique
  modality        String
  status          String    @default("Em ElaboraÃ§Ã£o")
  publicationDate DateTime?
  sessionDate     DateTime?

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  biddingAppointmentAssignments BiddingAppointmentAssignment[]
  biddingPhases                 BiddingPhase[]
  biddingActs                   BiddingAct[]
  biddingParticipants           BiddingParticipant[]
  biddingLots                   BiddingLot[]
}

model DirectContracting {
  id            String @id @default(cuid())
  type          String // Dispensa, Inexigibilidade
  justification String
  value         Float
  status        String @default("Em ElaboraÃ§Ã£o")

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  supplierId String
  supplier   Supplier @relation("SupplierDirectContracting", fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id           String   @id @default(cuid())
  number       String   @unique
  object       String
  initialValue Float
  updatedValue Float
  startDate    DateTime
  endDate      DateTime
  status       String   @default("Minuta") // Minuta, Vigente, Encerrado, etc.

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  supplierId String
  supplier   Supplier @relation("SupplierContracts", fields: [supplierId], references: [id])

  secretariatId String
  secretariat   Secretariat @relation("SecretariatContracts", fields: [secretariatId], references: [id])

  // The source budget unit is separate from the secretariat because one
  // secretariat can own more than one budget unit.
  sourceBudgetUnitId String?
  sourceBudgetUnit   BudgetUnit? @relation("ContractSourceBudgetUnit", fields: [sourceBudgetUnitId], references: [id], onDelete: Restrict)

  managerId String?
  manager   Employee? @relation("ContractManager", fields: [managerId], references: [id])

  inspectorId String?
  inspector   Employee? @relation("ContractInspector", fields: [inspectorId], references: [id])

  amendments           ContractAmendment[]
  culturaProjects      CulturaProjeto[]                @relation("CulturaProjectContract")
  commitments          Commitment[]                    @relation("FinancialCommitmentContract")
  receipts             PurchaseReceipt[]
  instrumentParties    InstrumentParty[]               @relation("ContractInstrumentParties")
  responsibilityGroups InstrumentResponsibilityGroup[] @relation("ContractResponsibilityGroups")
  measurements         InstrumentMeasurement[]         @relation("ContractInstrumentMeasurements")
  installments         InstrumentInstallment[]         @relation("ContractInstrumentInstallments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractAmendment {
  id              String    @id @default(cuid())
  type            String // Prazo, Valor, Ambos
  justification   String
  previousValue   Float?
  newValue        Float?
  previousEndDate DateTime?
  newEndDate      DateTime?
  status          String    @default("Minuta")

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// C5 procurement evidence is append-only. It links canonical procurement records
// without using the generic protocol Process as a procurement source.
model ProcurementLifecycleEvent {
  id             String   @id @default(cuid())
  eventType      String
  entityType     String
  entityId       String
  sourceType     String?
  sourceId       String?
  actorUsuarioId String
  actorUsuario   Usuario  @relation("ProcurementLifecycleEventActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([sourceType, sourceId])
}

model PurchaseReceipt {
  id                String                @id @default(cuid())
  number            String                @unique
  receivedAt        DateTime
  status            String                @default("APPROVED") // APPROVED, CANCELLED
  contractId        String
  contract          Contract              @relation(fields: [contractId], references: [id], onDelete: Restrict)
  purchaseProcessId String
  purchaseProcess   PurchaseProcess       @relation(fields: [purchaseProcessId], references: [id], onDelete: Restrict)
  documentId        String
  document          Document              @relation("PurchaseReceiptDocument", fields: [documentId], references: [id], onDelete: Restrict)
  receiverId        String
  receiver          Employee              @relation("PurchaseReceiptReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  attesterId        String
  attester          Employee              @relation("PurchaseReceiptAttester", fields: [attesterId], references: [id], onDelete: Restrict)
  idempotencyKey    String                @unique
  sourceType        String                @default("CONTRACT")
  sourceId          String
  items             PurchaseReceiptItem[]
  expense           Expense?              @relation("PurchaseReceiptExpense")
  commitment        Commitment?           @relation("PurchaseReceiptCommitment")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([purchaseProcessId, receivedAt])
  @@index([contractId, receivedAt])
  @@index([sourceType, sourceId])
}

model PurchaseReceiptItem {
  id                        String                     @id @default(cuid())
  purchaseReceiptId         String
  purchaseReceipt           PurchaseReceipt            @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  purchaseProcessItemId     String
  purchaseProcessItem       PurchaseProcessItem        @relation(fields: [purchaseProcessItemId], references: [id], onDelete: Restrict)
  materialId                String
  material                  Material                   @relation(fields: [materialId], references: [id], onDelete: Restrict)
  warehouseId               String
  warehouse                 Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity                  Float
  quantityIncorporated      Float                      @default(0)
  unitCost                  Float
  batchNumber               String                     @default("")
  expirationDate            DateTime?
  brand                     String?
  model                     String?
  serialNumber              String?
  stockMovementId           String                     @unique
  stockMovement             MaterialMovement           @relation("PurchaseReceiptItemMovement", fields: [stockMovementId], references: [id], onDelete: Restrict)
  assets                    Asset[]
  instrumentMeasurementItem InstrumentMeasurementItem? @relation("PurchaseReceiptItemInstrumentMeasurement")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([purchaseProcessItemId])
  @@index([materialId, warehouseId])
}

// Additive procurement traceability. Legacy request and process links remain intact.
model PurchaseRequestItemBudgetAllocation {
  id                    String              @id @default(cuid())
  purchaseRequestItemId String
  purchaseRequestItem   PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Restrict)
  budgetAppropriationId String
  budgetAppropriation   BudgetAppropriation @relation(fields: [budgetAppropriationId], references: [id], onDelete: Restrict)
  quantity              Float
  valueDecimal          Decimal             @db.Decimal(18, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([purchaseRequestItemId, budgetAppropriationId])
  @@index([budgetAppropriationId])
}

model PurchaseProcessRequestOrigin {
  id                String          @id @default(cuid())
  purchaseProcessId String
  purchaseProcess   PurchaseProcess @relation("PurchaseProcessRequestOriginProcess", fields: [purchaseProcessId], references: [id], onDelete: Restrict)
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation("PurchaseProcessRequestOriginRequest", fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([purchaseProcessId, purchaseRequestId])
  @@index([purchaseRequestId])
}

model PurchaseProcessItemOrigin {
  id                    String              @id @default(cuid())
  purchaseProcessItemId String
  purchaseProcessItem   PurchaseProcessItem @relation(fields: [purchaseProcessItemId], references: [id], onDelete: Restrict)
  purchaseRequestItemId String
  purchaseRequestItem   PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Restrict)
  quantity              Float
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([purchaseProcessItemId, purchaseRequestItemId])
  @@index([purchaseRequestItemId])
}

model SupplierPortalIdentity {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  status     String   @default("Ativo")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bids BiddingBid[] @relation("BiddingBidPortalIdentity")

  @@unique([supplierId, usuarioId])
  @@index([usuarioId, status])
}

// One appointment can describe a permanent/special commission or named officers.
model BiddingAppointment {
  id                    String    @id @default(cuid())
  kind                  String
  name                  String
  appointmentDocumentId String?
  appointmentDocument   Document? @relation("BiddingAppointmentDocument", fields: [appointmentDocumentId], references: [id], onDelete: Restrict)
  appointedAt           DateTime?
  endsAt                DateTime?
  status                String    @default("Ativa")
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  members     BiddingAppointmentMember[]
  assignments BiddingAppointmentAssignment[]

  @@index([kind, status])
  @@index([appointmentDocumentId])
}

model BiddingAppointmentMember {
  id            String             @id @default(cuid())
  appointmentId String
  appointment   BiddingAppointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  employeeId    String
  employee      Employee           @relation("BiddingAppointmentMemberEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  role          String
  appointedAt   DateTime?
  endsAt        DateTime?
  status        String             @default("Ativo")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([appointmentId, employeeId, role])
  @@index([employeeId, status])
}

model BiddingAppointmentAssignment {
  id                          String                     @id @default(cuid())
  biddingId                   String
  bidding                     Bidding                    @relation(fields: [biddingId], references: [id], onDelete: Restrict)
  appointmentId               String
  appointment                 BiddingAppointment         @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  role                        String?
  assignedAt                  DateTime                   @default(now())
  endedAt                     DateTime?
  status                      String                     @default("Ativa")
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  preliminaryTechnicalStudy   PreliminaryTechnicalStudy? @relation(fields: [preliminaryTechnicalStudyId], references: [id])
  preliminaryTechnicalStudyId String?

  @@unique([biddingId, appointmentId])
  @@index([appointmentId, status])
}

model BiddingPhase {
  id          String    @id @default(cuid())
  biddingId   String
  bidding     Bidding   @relation(fields: [biddingId], references: [id], onDelete: Restrict)
  code        String
  name        String
  sequence    Int
  version     Int       @default(1)
  isCurrent   Boolean   @default(true)
  status      String    @default("Pendente")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  acts                        BiddingAct[]
  preliminaryTechnicalStudy   PreliminaryTechnicalStudy? @relation(fields: [preliminaryTechnicalStudyId], references: [id])
  preliminaryTechnicalStudyId String?

  @@unique([biddingId, code, version])
  @@unique([biddingId, sequence, version])
  @@index([biddingId, isCurrent, sequence])
}

model BiddingAct {
  id             String        @id @default(cuid())
  biddingId      String
  bidding        Bidding       @relation(fields: [biddingId], references: [id], onDelete: Restrict)
  phaseId        String?
  phase          BiddingPhase? @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  biddingLotId   String?
  biddingLot     BiddingLot?   @relation(fields: [biddingLotId], references: [id], onDelete: Restrict)
  type           String
  description    String?
  status         String        @default("Registrado")
  occurredAt     DateTime      @default(now())
  documentId     String?
  document       Document?     @relation("BiddingActDocument", fields: [documentId], references: [id], onDelete: Restrict)
  actorUsuarioId String
  actorUsuario   Usuario       @relation("BiddingActActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  result                      BiddingResult?             @relation("BiddingResultAct")
  preliminaryTechnicalStudy   PreliminaryTechnicalStudy? @relation(fields: [preliminaryTechnicalStudyId], references: [id])
  preliminaryTechnicalStudyId String?

  @@index([biddingId, occurredAt])
  @@index([phaseId])
  @@index([biddingLotId, occurredAt])
  @@index([actorUsuarioId])
}

model BiddingParticipant {
  id           String   @id @default(cuid())
  biddingId    String
  bidding      Bidding  @relation(fields: [biddingId], references: [id], onDelete: Restrict)
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  displayCode  String?
  status       String   @default("Inscrito")
  registeredAt DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bids                        BiddingBid[]
  eligibilityDecisions        BiddingEligibility[]
  results                     BiddingResult[]
  preliminaryTechnicalStudy   PreliminaryTechnicalStudy? @relation(fields: [preliminaryTechnicalStudyId], references: [id])
  preliminaryTechnicalStudyId String?

  @@unique([biddingId, supplierId])
  @@unique([biddingId, displayCode])
  @@index([supplierId, status])
}

model BiddingLot {
  id                    String   @id @default(cuid())
  biddingId             String
  bidding               Bidding  @relation(fields: [biddingId], references: [id], onDelete: Restrict)
  number                Int
  description           String?
  status                String   @default("Rascunho")
  estimatedValueDecimal Decimal? @db.Decimal(18, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items                       BiddingLotItem[]
  bids                        BiddingBid[]
  acts                        BiddingAct[]
  eligibilityDecisions        BiddingEligibility[]
  results                     BiddingResult[]
  preliminaryTechnicalStudy   PreliminaryTechnicalStudy? @relation(fields: [preliminaryTechnicalStudyId], references: [id])
  preliminaryTechnicalStudyId String?

  @@unique([biddingId, number])
  @@index([biddingId, status])
}

model BiddingLotItem {
  id                    String              @id @default(cuid())
  biddingLotId          String
  biddingLot            BiddingLot          @relation(fields: [biddingLotId], references: [id], onDelete: Restrict)
  purchaseProcessItemId String
  purchaseProcessItem   PurchaseProcessItem @relation(fields: [purchaseProcessItemId], references: [id], onDelete: Restrict)
  quantity              Float
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([biddingLotId, purchaseProcessItemId])
  @@index([purchaseProcessItemId])
}

model BiddingBid {
  id                       String                 @id @default(cuid())
  biddingLotId             String
  biddingLot               BiddingLot             @relation(fields: [biddingLotId], references: [id], onDelete: Restrict)
  participantId            String
  participant              BiddingParticipant     @relation(fields: [participantId], references: [id], onDelete: Restrict)
  supplierPortalIdentityId String
  supplierPortalIdentity   SupplierPortalIdentity @relation("BiddingBidPortalIdentity", fields: [supplierPortalIdentityId], references: [id], onDelete: Restrict)
  kind                     String                 @default("Lance")
  unitValueDecimal         Decimal?               @db.Decimal(18, 2)
  totalValueDecimal        Decimal                @db.Decimal(18, 2)
  sequence                 Int
  submittedAt              DateTime               @default(now())
  status                   String                 @default("Aceito")
  idempotencyKey           String                 @unique
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  results BiddingResult[]

  @@unique([biddingLotId, sequence])
  @@index([participantId, submittedAt])
  @@index([supplierPortalIdentityId])
}

model BiddingEligibility {
  id                 String             @id @default(cuid())
  biddingLotId       String
  biddingLot         BiddingLot         @relation(fields: [biddingLotId], references: [id], onDelete: Restrict)
  participantId      String
  participant        BiddingParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  status             String
  reason             String?
  documentId         String?
  document           Document?          @relation("BiddingEligibilityDocument", fields: [documentId], references: [id], onDelete: Restrict)
  decidedByUsuarioId String
  decidedByUsuario   Usuario            @relation("BiddingEligibilityDecider", fields: [decidedByUsuarioId], references: [id], onDelete: Restrict)
  decidedAt          DateTime           @default(now())
  idempotencyKey     String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([biddingLotId, participantId, decidedAt])
  @@index([decidedByUsuarioId])
  @@index([documentId])
}

model BiddingResult {
  id                 String             @id @default(cuid())
  biddingLotId       String
  biddingLot         BiddingLot         @relation(fields: [biddingLotId], references: [id], onDelete: Restrict)
  participantId      String
  participant        BiddingParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  biddingBidId       String?
  biddingBid         BiddingBid?        @relation(fields: [biddingBidId], references: [id], onDelete: Restrict)
  biddingActId       String?            @unique
  biddingAct         BiddingAct?        @relation("BiddingResultAct", fields: [biddingActId], references: [id], onDelete: Restrict)
  status             String             @default("Arrematado")
  reason             String?
  unitValueDecimal   Decimal?           @db.Decimal(18, 2)
  totalValueDecimal  Decimal            @db.Decimal(18, 2)
  isCurrent          Boolean            @default(true)
  decidedByUsuarioId String
  decidedByUsuario   Usuario            @relation("BiddingResultDecider", fields: [decidedByUsuarioId], references: [id], onDelete: Restrict)
  decidedAt          DateTime           @default(now())
  idempotencyKey     String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([biddingLotId, isCurrent, decidedAt])
  @@index([participantId])
  @@index([biddingBidId])
  @@index([decidedByUsuarioId])
}

// These children keep the established Contract and Covenant headers as the
// canonical instruments instead of introducing a parallel instrument master.
model InstrumentResponsibilityGroup {
  id          String    @id @default(cuid())
  contractId  String?
  contract    Contract? @relation("ContractResponsibilityGroups", fields: [contractId], references: [id], onDelete: Restrict)
  covenantId  String?
  covenant    Covenant? @relation("CovenantResponsibilityGroups", fields: [covenantId], references: [id], onDelete: Restrict)
  name        String
  description String?
  status      String    @default("Ativo")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members InstrumentParty[] @relation("InstrumentResponsibilityGroupMembers")

  @@unique([contractId, name])
  @@unique([covenantId, name])
  @@index([contractId, status])
  @@index([covenantId, status])
}

model InstrumentParty {
  id                    String                         @id @default(cuid())
  contractId            String?
  contract              Contract?                      @relation("ContractInstrumentParties", fields: [contractId], references: [id], onDelete: Restrict)
  covenantId            String?
  covenant              Covenant?                      @relation("CovenantInstrumentParties", fields: [covenantId], references: [id], onDelete: Restrict)
  role                  String
  supplierId            String?
