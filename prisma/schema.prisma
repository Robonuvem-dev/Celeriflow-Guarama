  withholdingPayableId String?
  withholdingPayable   WithholdingPayable? @relation("FinancialDocumentWithholdingPayable", fields: [withholdingPayableId], references: [id], onDelete: Restrict)

  @@unique([commitmentId])
  @@unique([settlementId])
  @@unique([paymentId])
  @@unique([withholdingPayableId])
  @@index([documentType, generatedAt])
}

model PaymentRetention {
  id                    String               @id @default(cuid())
  paymentId             String
  payment               Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
