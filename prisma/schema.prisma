model AccountingPlan {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String // Receita, Despesa, Ativo, Passivo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries            AccountingEntry[]
  bankAccount        BankAccount?            @relation("BankAccountAccountingPlan")
  debitPostingRules  AccountingPostingRule[] @relation("PostingRuleDebitAccount")
  debitPostingComponents AccountingPostingComponent[] @relation("PostingComponentDebitAccount")
  creditPostingComponents AccountingPostingComponent[] @relation("PostingComponentCreditAccount")
  creditPostingRules AccountingPostingRule[] @relation("PostingRuleCreditAccount")
}

model AccountingEntry {
  id            String                 @id @default(cuid())
  date          DateTime               @default(now())
  value         Float
  valueDecimal  Decimal?               @db.Decimal(18, 2)
  classificationSnapshot Json?
  type          String // DÃ©bito, CrÃ©dito
  history       String
  accountId     String
  account       AccountingPlan         @relation(fields: [accountId], references: [id])
  authorId      String
  author        Employee               @relation("AccountingEntryAuthor", fields: [authorId], references: [id])
  transactionId String?
  transaction   AccountingTransaction? @relation(fields: [transactionId], references: [id])
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([transactionId, accountId])
}

model AccountingTransaction {
  id               String                 @id @default(cuid())
  governmentEntityId String?
  governmentEntity GovernmentEntity?       @relation(fields: [governmentEntityId], references: [id], onDelete: Restrict)
  budgetUnitId     String?
  budgetUnit       BudgetUnit?             @relation(fields: [budgetUnitId], references: [id], onDelete: Restrict)
  financialYearId  String
  financialYear    FinancialYear          @relation(fields: [financialYearId], references: [id])
  date             DateTime
  history          String
  status           String                 @default("RASCUNHO")
  sourceModule     String                 @default("MANUAL")
  sourceType       String                 @default("ACCOUNTING_TRANSACTION")
  sourceId         String?
  eventType        String                 @default("MANUAL_POSTING")
  idempotencyKey   String?                @unique
  authorUsuarioId  String
  authorUsuario    Usuario                @relation("AccountingTransactionUsuario", fields: [authorUsuarioId], references: [id])
  authorEmployeeId String?
  authorEmployee   Employee?              @relation("AccountingTransactionEmployee", fields: [authorEmployeeId], references: [id])
  postedAt         DateTime?
  reversalOfId     String?                @unique
  reversalOf       AccountingTransaction? @relation("AccountingReversal", fields: [reversalOfId], references: [id])
  reversedBy       AccountingTransaction? @relation("AccountingReversal")
  entries          AccountingEntry[]
  assetWriteOff    AssetWriteOff?         @relation("AssetWriteOffAccountingTransaction")
  assetDepreciation AssetValueHistory? @relation("AssetDepreciationAccounting")
  assetValueAdjustment AssetValueAdjustment? @relation("AssetAdjustmentAccounting")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([financialYearId, date, status])
  @@index([governmentEntityId, financialYearId, date, status])
  @@index([budgetUnitId, financialYearId, date, status])
  @@index([sourceModule, sourceType, sourceId])
}

model AccountingEventCatalog {
  id          String                  @id @default(cuid())
  code        String                  @unique
  name        String
  description String?
  isActive    Boolean                 @default(true)
  rules       AccountingPostingRule[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model AccountingPostingRule {
  id              String                 @id @default(cuid())
  eventId         String
  event           AccountingEventCatalog @relation(fields: [eventId], references: [id], onDelete: Cascade)
  debitAccountId  String
  debitAccount    AccountingPlan         @relation("PostingRuleDebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String
  creditAccount   AccountingPlan         @relation("PostingRuleCreditAccount", fields: [creditAccountId], references: [id])
  description     String?
  isActive        Boolean                @default(true)
  isReference     Boolean                @default(false)
  components      AccountingPostingComponent[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([eventId, debitAccountId, creditAccountId])
}

model AccountingPostingComponent {
  id                  String @id @default(cuid())
  ruleId              String
  rule                AccountingPostingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sequence            Int
  debitAccountId      String
  debitAccount        AccountingPlan @relation("PostingComponentDebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId     String
  creditAccount       AccountingPlan @relation("PostingComponentCreditAccount", fields: [creditAccountId], references: [id])
  valueBasis          String @default("EVENT_VALUE")
  creditFromOriginBank Boolean @default(false)

  @@unique([ruleId, sequence])
}

model MonthlyAccountingClose {
  id                 String                        @id @default(cuid())
  financialYearId    String
  financialYear      FinancialYear                 @relation(fields: [financialYearId], references: [id])
  competence         DateTime
  status             String                        @default("ABERTO")
  pendingSummary     Json?
  closedByUsuarioId  String?
  closedByUsuario    Usuario?                      @relation("MonthlyCloseUsuario", fields: [closedByUsuarioId], references: [id])
  closedByEmployeeId String?
  closedByEmployee   Employee?                     @relation("MonthlyCloseEmployee", fields: [closedByEmployeeId], references: [id])
  closedAt           DateTime?
  events             MonthlyAccountingCloseEvent[]
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@unique([financialYearId, competence])
}

model MonthlyAccountingCloseEvent {
  id                       String                 @id @default(cuid())
  monthlyAccountingCloseId String
  monthlyAccountingClose   MonthlyAccountingClose @relation(fields: [monthlyAccountingCloseId], references: [id], onDelete: Cascade)
  action                   String
  justification            String?
  pendingSummary           Json?
  closureEvidence          Json?
  requestedByUsuarioId     String
  requestedByUsuario       Usuario                @relation("MonthlyCloseEventRequestedBy", fields: [requestedByUsuarioId], references: [id])
  authorizedByUsuarioId    String?
  authorizedByUsuario      Usuario?               @relation("MonthlyCloseEventAuthorizedBy", fields: [authorizedByUsuarioId], references: [id])
  requestedAt              DateTime               @default(now())
  authorizedAt             DateTime?
  createdAt                DateTime               @default(now())

