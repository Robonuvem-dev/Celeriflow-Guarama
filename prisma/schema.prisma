  @@index([requestedByUsuarioId])
  @@index([authorizedByUsuarioId])
}

model AnnualAccountingClose {
  id                  String        @id @default(cuid())
  financialYearId     String        @unique
  financialYear       FinancialYear @relation(fields: [financialYearId], references: [id])
  status              String        @default("EM_PREPARACAO")
  pendingSummary      Json?
  preparedByUsuarioId String?
  preparedAt          DateTime?
  closedByUsuarioId   String?
  closedByUsuario     Usuario?      @relation("AnnualCloseUsuario", fields: [closedByUsuarioId], references: [id])
  closedByEmployeeId  String?
  closedByEmployee    Employee?     @relation("AnnualCloseEmployee", fields: [closedByEmployeeId], references: [id])
  closedAt            DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model PayableCarryForward {
  id                            String                     @id @default(cuid())
  financialYearId               String
  financialYear                 FinancialYear              @relation("PayableCarryForwardRegistration", fields: [financialYearId], references: [id])
  originFinancialYearId         String
  originFinancialYear           FinancialYear              @relation("PayableCarryForwardOrigin", fields: [originFinancialYearId], references: [id])
  commitmentId                  String
  commitment                    Commitment                 @relation(fields: [commitmentId], references: [id])
  previousPayableCarryForwardId String?                    @unique
  previousPayableCarryForward   PayableCarryForward?       @relation("PayableCarryForwardReregistration", fields: [previousPayableCarryForwardId], references: [id])
  successorPayableCarryForward  PayableCarryForward?       @relation("PayableCarryForwardReregistration")
  valueDecimal                  Decimal                    @db.Decimal(18, 2)
  type                          String
  status                        String                     @default("PENDENTE")
  notes                         String?
  bankTransactionId             String?
  integrationEventId            String?
  paymentOrderExternalId        String?
  events                        PayableCarryForwardEvent[]
  nativePayments                Payment[] @relation("NativeCarryForwardPayments")
  nativeSettlements             Settlement[] @relation("NativeCarryForwardSettlements")
  inheritedSettlements          PayableCarryForwardSettlementLink[] @relation("InheritedCarryForwardSettlement")
  transportedSettlements        PayableCarryForwardSettlementLink[] @relation("TransportedCarryForwardSettlement")
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  @@unique([financialYearId, commitmentId, type])
  @@index([originFinancialYearId, type])
  @@index([status])
  @@index([bankTransactionId])
}

// Histórico da inscrição: acompanhamento legado e confirmação/estorno dos pagamentos nativos.
model PayableCarryForwardSettlementLink {
  id                          String @id @default(cuid())
  payableCarryForwardId       String
  payableCarryForward         PayableCarryForward @relation("InheritedCarryForwardSettlement", fields: [payableCarryForwardId], references: [id], onDelete: Restrict)
  sourcePayableCarryForwardId String
  sourcePayableCarryForward   PayableCarryForward @relation("TransportedCarryForwardSettlement", fields: [sourcePayableCarryForwardId], references: [id], onDelete: Restrict)
  settlementId                String
  settlement                  Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  sourceFinancialYearId       String
  sourceFinancialYear         FinancialYear @relation(fields: [sourceFinancialYearId], references: [id], onDelete: Restrict)
  transportAuditId            String
  transportAudit              FinancialAuditLog @relation(fields: [transportAuditId], references: [id], onDelete: Restrict)
  valueDecimal                Decimal @db.Decimal(18, 2)
  status                      String @default("ACTIVE")
  createdAt                   DateTime @default(now())

  @@unique([payableCarryForwardId, settlementId])
  @@index([sourcePayableCarryForwardId])
}

model PayableCarryForwardEvent {
  id                    String              @id @default(cuid())
  payableCarryForwardId String
  payableCarryForward   PayableCarryForward @relation(fields: [payableCarryForwardId], references: [id], onDelete: Restrict)
  action                String
  justification         String?
  valueDecimal          Decimal?            @db.Decimal(18, 2)
  paymentId             String?
  payment               Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  settlementId          String?
  settlement            Settlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  actorUsuarioId        String
  actorUsuario          Usuario             @relation("PayableCarryForwardEventActor", fields: [actorUsuarioId], references: [id])
  createdAt             DateTime            @default(now())

  @@index([payableCarryForwardId, createdAt])
  @@index([actorUsuarioId])
  @@index([paymentId])
  @@unique([payableCarryForwardId, paymentId, action])
  @@unique([payableCarryForwardId, settlementId, action])
}

