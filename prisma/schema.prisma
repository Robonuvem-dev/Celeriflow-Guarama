  returnMovements    MaterialMovement[] @relation("MaterialMovementReturns")

  reversedMovementId String?           @unique
  reversedMovement   MaterialMovement? @relation("MaterialMovementReversal", fields: [reversedMovementId], references: [id], onDelete: Restrict)
  reversalMovement   MaterialMovement? @relation("MaterialMovementReversal")

  actorUsuarioId  String?
  actorUsuario    Usuario?  @relation("MaterialMovementActorUsuario", fields: [actorUsuarioId], references: [id])
  actorEmployeeId String?
  actorEmployee   Employee? @relation("MaterialMovementActor", fields: [actorEmployeeId], references: [id])

  inventorySessionId      String?
  inventorySession        InventorySession?        @relation("InventoryAdjustmentSession", fields: [inventorySessionId], references: [id])
  inventoryItem           InventorySessionItem?    @relation("InventoryItemAdjustment")
