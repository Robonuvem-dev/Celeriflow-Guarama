  documentId String @unique
  documentVersionId String @unique
  filename String
  pathname String @unique
  requestId String?
  request PortalServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  targetRequestId String?
  createdAt DateTime @default(now())
  @@index([ownerId, requestId])
}

model PortalServiceFavorite {
  id String @id @default(cuid())
  actorId String
  publicServiceId String
  publicService PublicService @relation(fields: [publicServiceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([actorId, publicServiceId])
}

model PortalServiceRating {
  id String @id @default(cuid())
  requestId String @unique
  request PortalServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  serviceScore Int
  qualityScore Int
  deadlineScore Int
  comment String
