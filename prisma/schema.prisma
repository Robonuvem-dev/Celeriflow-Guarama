model TaxBenefitRule {
  id                 String    @id @default(cuid())
  code               String
  name               String
  benefitType        String
  legalReference     String
  eligibility        Json
  calculation        Json
  effectiveFrom      DateTime
  effectiveUntil     DateTime?
  active             Boolean   @default(true)
  createdByUsuarioId String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  grants TaxBenefitGrant[]

  @@unique([code, effectiveFrom])
  @@index([active, effectiveFrom])
}

model TaxBenefitGrant {
  id                    String         @id @default(cuid())
  ruleId                String
  rule                  TaxBenefitRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  taxpayerId            String
  sourceType            String
  sourceId              String
  originalAmountDecimal Decimal        @db.Decimal(18, 2)
  creditDecimal         Decimal        @default(0) @db.Decimal(18, 2)
  reductionDecimal      Decimal        @default(0) @db.Decimal(18, 2)
  renunciationDecimal   Decimal        @default(0) @db.Decimal(18, 2)
  finalAmountDecimal    Decimal        @db.Decimal(18, 2)
  status                String         @default("CONCEDIDO")
  calculationSnapshot   Json
  grantedByUsuarioId    String
  grantedAt             DateTime       @default(now())
  createdAt             DateTime       @default(now())

  @@unique([ruleId, taxpayerId, sourceType, sourceId])
  @@index([taxpayerId, status])
  @@index([grantedAt])
}

model TaxPrizeDraw {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  year                 Int
  drawNumber           Int
  status               String    @default("RASCUNHO")
  scheduledAt          DateTime
  eligibilityRules     Json
  requiresPayment      Boolean   @default(false)
  taxpayerTypes        Json
  winnerCount          Int       @default(1)
  technicalSeed        String
  officialActReference String?
  createdByUsuarioId   String
  executedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  coupons    TaxPrizeCoupon[]
  executions TaxPrizeExecution[]

  @@unique([year, drawNumber])
  @@index([status, scheduledAt])
}

model TaxPrizeCoupon {
  id                  String       @id @default(cuid())
  drawId              String
  draw                TaxPrizeDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  couponNumber        String
  taxpayerId          String
  sourceDocumentType  String
  sourceDocumentId    String
  eligibilitySnapshot Json
  status              String       @default("ELEGIVEL")
  issuedAt            DateTime     @default(now())

  winners TaxPrizeWinner[]

  @@unique([drawId, couponNumber])
  @@unique([drawId, sourceDocumentType, sourceDocumentId])
  @@index([taxpayerId, status])
}

model TaxPrizeExecution {
  id                  String       @id @default(cuid())
  drawId              String
  draw                TaxPrizeDraw @relation(fields: [drawId], references: [id], onDelete: Restrict)
  executionNumber     Int
  algorithm           String
  seedHash            String
  inputHash           String
  resultHash          String
  status              String       @default("CONCLUIDA")
  executedAt          DateTime     @default(now())
  executedByUsuarioId String

  winners TaxPrizeWinner[]

  @@unique([drawId, executionNumber])
}

model TaxPrizeWinner {
  id          String            @id @default(cuid())
  executionId String
  execution   TaxPrizeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  couponId    String
  coupon      TaxPrizeCoupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  position    Int
  resultKey   String
  createdAt   DateTime          @default(now())

  @@unique([executionId, position])
  @@unique([executionId, couponId])
}

model SstLeavePayrollScopeEvidence {
  id String @id @default(cuid())
  payrollId String
  scope SstBenefitPayrollScope @relation(fields: [payrollId], references: [payrollId], onDelete: Restrict)
  certificateId String
  certificate SstMedicalCertificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  sourceReference String
  createdById String
  createdAt DateTime @default(now())
}

model SstLeavePayrollRuleVersion {
  id String @id
  ruleId String
  rule HrPayrollRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleSetId String
  ruleSet HrPayrollRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  fingerprint String
  snapshot Json
  createdById String
  createdAt DateTime @default(now())
  origins SstLeavePayrollOrigin[]
  @@unique([ruleId, fingerprint])
}

model SstLeavePayrollOrigin {
  id String @id @default(cuid())
  sourceKey String @unique
  kind String
  certificateId String
  certificate SstMedicalCertificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  assessmentId String?
  assessment SstMedicalAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  decisionRevisionId String? // FK to immutable SQL-owned SstCertificateDecisionRevision.
  leaveId String
  leave Leave @relation(fields: [leaveId], references: [id], onDelete: Restrict)
  functionalPeriodId String // FK to immutable SQL-owned canonical RH history.
  employeeId String
  budgetUnitId String
  governmentEntityId String
  payrollId String
  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Restrict)
  payrollItemId String @unique
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Restrict)
  competence String
  ruleVersionId String
  ruleVersion SstLeavePayrollRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  rubricId String // Canonical FK enforced by additive SQL migration.
  reversesId String? @unique
  reverses SstLeavePayrollOrigin? @relation("SstLeavePayrollCompensation", fields: [reversesId], references: [id], onDelete: Restrict)
  compensation SstLeavePayrollOrigin? @relation("SstLeavePayrollCompensation")
  attestedMinutes Decimal @db.Decimal(24, 10)
  coverage Unsupported("tsmultirange")
  amountDecimal Decimal @db.Decimal(18, 2)
  eventType String
  snapshot Json
  createdById String
  createdAt DateTime @default(now())
  @@index([employeeId, competence, kind], map: "sst_leave_origin_worker_competence")
}
