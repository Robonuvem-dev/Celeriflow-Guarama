  revenueNature        RevenueNature  @relation(fields: [revenueNatureId], references: [id])
  resourceSourceId     String
  resourceSource       ResourceSource @relation(fields: [resourceSourceId], references: [id])
  defaultBankAccountId String
  defaultBankAccount   BankAccount    @relation(fields: [defaultBankAccountId], references: [id])
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model TaxDocumentSequence {
