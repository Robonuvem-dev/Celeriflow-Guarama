// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id             String   @id @default(cuid())
  name           String
  role           String?
  organization   String
  city           String
  state          String
  email          String
  phone          String?
  moduleInterest String?
  message        String?
  consent        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- MÃ³dulo 1: AdministraÃ§Ã£o Geral ---

// Cadastro Ãºnico da Prefeitura/Entidade Principal
model Institution {
  id          String   @id @default(cuid())
  name        String
  cnpj        String?
  legalName   String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  mayorName   String?
  managerName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// The instance-wide visual layout; institutional identity remains in Institution.
model ReportTemplate {
  id                      String   @id @default(cuid())
  scope                   String   @unique @default("GLOBAL")
  version                 Int      @default(1)
  fingerprint             String   @unique
  header                  String   @default("")
  footer                  String   @default("")
  orientation             String   @default("LANDSCAPE")
  includeEmissionMetadata Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Secretarias, Autarquias e Fundos
model Secretariat {
  id          String               @id @default(cuid())
  name        String
  acronym     String?
  managerName String?
  managerId   String?
  manager     Employee? @relation("SecretariatManager", fields: [managerId], references: [id], onDelete: SetNull)
  departments Department[]
  units       AdministrativeUnit[]
  employees   Employee[]
  demands     InternalDemand[]

  // Mod 6
  portalNews PortalNews[] @relation("NewsSecretariat")

  // Mod 8
  budgetUnits BudgetUnit[] @relation("SecretariatBudgetUnits")
  revenues    Revenue[]    @relation("SecretariatRevenues")
  expenses    Expense[]    @relation("SecretariatExpenses")

  // Mod 9
  purchaseRequests   PurchaseRequest[] @relation("SecretariatPurchaseRequests")
  purchaseProcesses  PurchaseProcess[] @relation("SecretariatPurchaseProcesses")
  contracts          Contract[]        @relation("SecretariatContracts")
  camaraLegislaturas CamLegislatura[]  @relation("CamaraLegislatureSecretariat")
  costCenters        CostCenter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@index([managerId])
}

// Departamentos / Setores
model Department {
  constructionStaff ConstructionStaffRole[]
  id            String           @id @default(cuid())
  name          String
  description   String?
  secretariatId String
  secretariat   Secretariat      @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  employees     Employee[]
  demands       InternalDemand[]

  // Mod 3
  currentProcesses      Process[]                     @relation("CurrentDepartment")
  movementsFrom         ProcessMovement[]             @relation("MovementFrom")
  movementsTo           ProcessMovement[]             @relation("MovementTo")
  dispatches            ProcessDispatch[]             @relation("DispatchDepartment")
  initialProcessTypes   ProcessType[]                 @relation("ProcessTypeInitialDepartment")
  initialSubjects       Subject[]                     @relation("SubjectInitialDepartment")
  processEvents         ProcessEvent[]                @relation("ProcessEventDepartment")
  workflowStages        ProcessWorkflowStage[]
  genericWorkflowStages GenericProcessWorkflowStage[]

  // Mod 4 e 5
  folders                Folder[]            @relation("FolderDepartment")
  tickets                Ticket[]            @relation("TicketDepartment")
  ombudsmans             Ombudsman[]         @relation("OmbudsmanDepartment")
  serviceSubjects        ServiceSubject[]    @relation("ServiceSubjectDepartment")
  ticketMovementsFrom    TicketMovement[]    @relation("TicketMovementFromDepartment")
  ticketMovementsTo      TicketMovement[]    @relation("TicketMovementToDepartment")
  ombudsmanMovementsFrom OmbudsmanMovement[] @relation("OmbudsmanMovementFromDepartment")
  ombudsmanMovementsTo   OmbudsmanMovement[] @relation("OmbudsmanMovementToDepartment")

  // Mod 9
  purchaseRequests PurchaseRequest[] @relation("DepartmentPurchaseRequests")

  // Mod 11
  assets           Asset[]
  transfersFrom    AssetTransfer[]    @relation("TransferFromDept")
  transfersTo      AssetTransfer[]    @relation("TransferToDept")
  materialMoves    MaterialMovement[] @relation("MovementDepartment")
  materialRequests MaterialRequest[]  @relation("MaterialRequestDepartment")
  equipmentCustodies EquipmentCustody[]
  obrasServices    ObrasServico[]     @relation("ObrasServicoDepartment")
  obrasTeams       ObrasEquipe[]
  costCenters      CostCenter[]
  fleetDebtSettings FleetDebtSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

// Unidades Administrativas (Escolas, UBS, CRAS, Almoxarifados)
model AdministrativeUnit {
  id            String       @id @default(cuid())
  name          String
  type          String // e.g., 'Escola', 'UBS', 'CRAS', 'Almoxarifado'
  address       String?
  managerName   String?
  secretariatId String
  secretariat   Secretariat  @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  employees     Employee[]
  costCenters   CostCenter[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  isActive      Boolean      @default(true)
}

// Cargos e FunÃ§Ãµes
// Immutable CAT source; SstCatEvidence/ledger are accessed with typed parameterized SQL.
model SstCat {
  id String @id
  budgetUnitId String
  budgetUnit BudgetUnit @relation(fields: [budgetUnitId], references: [id])
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id])
  createdById String
  createdBy Usuario @relation(fields: [createdById], references: [id])
  submissionKey String
  requestHash String
  occurredAt DateTime
  kind String
  source String
  data Json
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([budgetUnitId, submissionKey])
  @@index([budgetUnitId, occurredAt, id], map: "SstCat_scope_date")
}

// F6 SST prevention: validated operational payloads and immutable revisions.
model SstPreventionRecord {
  id String @id
  budgetUnitId String
  budgetUnit BudgetUnit @relation(fields: [budgetUnitId], references: [id], onDelete: Restrict)
  kind String
  title String
  payload Json
  clinical Boolean @default(false)
  createdById String
  createdBy Usuario @relation("SstPreventionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  submissionKey String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  revisions SstPreventionRevision[]
  electors SstElectionElector[]
  candidates SstElectionCandidate[]
  ballots SstElectionBallot[]
  @@unique([createdById, submissionKey])
  @@index([budgetUnitId, kind, createdAt, id], map: "SstPreventionRecord_scope")
}
model SstPreventionRevision {
  id String @id
  recordId String
  record SstPreventionRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  version Int
  artifact Json
  actorId String
  actor Usuario @relation("SstPreventionRevisionAuthor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([recordId, version])
}
model SstElectionElector {
  electionId String
  election SstPreventionRecord @relation(fields: [electionId], references: [id], onDelete: Restrict)
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  personId String
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  candidates SstElectionCandidate[]
  turnout SstElectionTurnout?
  @@id([electionId, employeeId])
}
model SstElectionCandidate {
  id String @id
  electionId String
  election SstPreventionRecord @relation(fields: [electionId], references: [id], onDelete: Restrict)
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  elector SstElectionElector @relation(fields: [electionId, employeeId], references: [electionId, employeeId], onDelete: Restrict)
  nameSnapshot String
  ballots SstElectionBallot[]
  @@unique([electionId, employeeId])
  @@unique([electionId, id])
}
model SstElectionTurnout {
  electionId String
  employeeId String
  elector SstElectionElector @relation(fields: [electionId, employeeId], references: [electionId, employeeId], onDelete: Restrict)
  @@id([electionId, employeeId])
}
model SstElectionBallot {
  id String @id
  electionId String
  election SstPreventionRecord @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidateId String?
  candidate SstElectionCandidate? @relation(fields: [electionId, candidateId], references: [electionId, id], onDelete: Restrict)
  @@index([electionId, candidateId], map: "SstElectionBallot_count")
}

model HrRoleLegalHistory {
  id String @id @default(cuid())
  governmentEntityId String
  roleId String
  effectiveFrom DateTime
  version Int
  state String
  designation String
  authorizedSeats Int
  legalReference String
  legalTextVersionId String
  documentId String
  documentVersionId String
  documentHash String
  documentFileUrl String
  reason String
  rectification Boolean @default(false)
  previousEventId String? @unique
  actorUsuarioId String
  idempotencyKey String
  requestHash String
  createdAt DateTime @default(now())
  @@unique([governmentEntityId, roleId, version])
  @@unique([governmentEntityId, idempotencyKey])
  @@index([governmentEntityId, roleId, effectiveFrom, version])
}

model Role {
  id          String     @id @default(cuid())
  name        String
  description String?
  level       String? // 'Diretor', 'Coordenador', 'Servidor', etc.
  canSign     Boolean    @default(false)
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

