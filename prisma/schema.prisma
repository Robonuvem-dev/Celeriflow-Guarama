  updatedAt DateTime @updatedAt

  @@index([stockId])
  @@index([actorUsuarioId])
  @@index([actorEmployeeId])
  @@index([inventorySessionId])
  @@index([settlementId])
  @@index([materialRequestItemId])
  @@index([returnedMovementId])
}

model MaterialStockValuation {
