  creditRequestLegalEvidence     CreditRequest[]               @relation("CreditRequestLegalEvidence")
  biddingAppointmentDocuments    BiddingAppointment[]          @relation("BiddingAppointmentDocument")
  biddingActDocuments            BiddingAct[]                  @relation("BiddingActDocument")
  biddingEligibilityDocuments    BiddingEligibility[]          @relation("BiddingEligibilityDocument")
