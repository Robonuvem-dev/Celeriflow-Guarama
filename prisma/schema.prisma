  treasuryTransfer        TreasuryTransfer? @relation(fields: [treasuryTransferId], references: [id])
  valueDecimal            Decimal           @db.Decimal(18, 2)
  status                  String            @default("ATIVA")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

