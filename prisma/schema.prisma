model Settlement {
  id                      String     @id @default(cuid())
  date                    DateTime   @default(now())
  value                   Float
  valueDecimal            Decimal?   @db.Decimal(18, 2)
  documentRef             String? // NF, Recibo, etc
  fiscalDocumentNumber    String?
  fiscalDocumentSeries    String?
  fiscalDocumentIssueDate DateTime?
  fiscalDocumentAccessKey String?    @unique
  documentId              String?
