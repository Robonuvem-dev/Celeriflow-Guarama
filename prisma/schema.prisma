  group String
  provider String
  audience String @default("CIDADAO")
  requiresLogin Boolean @default(true)
  published Boolean @default(false)
  featured Boolean @default(false)
  sortOrder Int @default(0)
  version Int @default(1)
  configuration Json
  versions PortalServiceVersion[]
  requests PortalServiceRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CitizenAccessApplication {
  id String @id @default(cuid())
  firebaseUid String @unique
  email String
  name String
  declaredDocument String
  requestHash String
  processId String @unique
  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)
  status String @default("PENDENTE")
  reason String?
  decidedById String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}

model CitizenRegistryIdentity {
