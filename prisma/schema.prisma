  @@index([settlementRetentionId])
  @@index([retentionRuleId])
}

// RetenÃ§Ãµes sÃ£o apuradas no ateste da liquidaÃ§Ã£o. PaymentRetention registra apenas
// a parcela vinculada a cada ordem de pagamento e ao posterior recolhimento.
model SettlementRetention {
  id                     String        @id @default(cuid())
  settlementId           String
  settlement             Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  retentionRuleId        String
  retentionRule          RetentionRule @relation(fields: [retentionRuleId], references: [id], onDelete: Restrict)
  type                   String
  description            String?
  calculationBaseDecimal Decimal       @db.Decimal(18, 2)
  ratePercentage         Decimal       @db.Decimal(7, 4)
  valueDecimal           Decimal       @db.Decimal(18, 2)
  beneficiaryName        String
  beneficiaryDocument    String?
  dueDate                DateTime?
  createdAt              DateTime      @default(now())

  paymentRetentions PaymentRetention[]

  @@unique([settlementId, retentionRuleId])
  @@index([retentionRuleId])
}

model RetentionRule {
  id                        String         @id @default(cuid())
  code                      String         @unique
  type                      String
  description               String
  calculationBasePercentage Decimal        @db.Decimal(7, 4)
  ratePercentage            Decimal        @db.Decimal(7, 4)
  beneficiaryName           String
  beneficiaryDocument       String?
  serviceCode               String?
  financialYearId           String?
  financialYear             FinancialYear? @relation(fields: [financialYearId], references: [id])
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  dueDays                   Int?
  isActive                  Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  paymentRetentions    PaymentRetention[]
  settlementRetentions SettlementRetention[]

  @@index([isActive, effectiveFrom, effectiveTo])
  @@index([financialYearId, serviceCode])
}

model WithholdingPayable {
  id                String             @id @default(cuid())
  retentionId       String             @unique
  retention         PaymentRetention   @relation(fields: [retentionId], references: [id], onDelete: Restrict)
  creditorId        String?
  creditor          Creditor?          @relation(fields: [creditorId], references: [id])
  receiptDocumentId String?
  receiptDocument   Document?          @relation("WithholdingReceiptDocument", fields: [receiptDocumentId], references: [id], onDelete: Restrict)
  dueDate           DateTime?
  valueDecimal      Decimal            @db.Decimal(18, 2)
  status            String             @default("Pendente") // Pendente, Recolhida, Cancelada
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  financialDocument FinancialDocument? @relation("FinancialDocumentWithholdingPayable")

  @@index([status, dueDate])
  @@index([receiptDocumentId])
}

model BankAccount {
  id                        String          @id @default(cuid())
  bankName                  String
  agency                    String
  bankId                    String?
  bank                      Bank?           @relation(fields: [bankId], references: [id], onDelete: Restrict)
  bankBranchId              String?
  bankBranch                BankBranch?     @relation(fields: [bankBranchId], references: [id], onDelete: Restrict)
  accountNumber             String
  accountType               String          @default("Movimento")
  currentBalance            Float           @default(0)
  currentBalanceDecimal     Decimal?        @db.Decimal(18, 2)
  resourceSourceId          String?
  resourceSource            ResourceSource? @relation(fields: [resourceSourceId], references: [id])
  permittedSources          BankAccountResourceSource[]
  budgetUnitId              String?
  budgetUnit                BudgetUnit?     @relation(fields: [budgetUnitId], references: [id])
  accountingPlanId          String?         @unique
  accountingPlan            AccountingPlan? @relation("BankAccountAccountingPlan", fields: [accountingPlanId], references: [id])
  isActive                  Boolean         @default(true)
  externalId                String?         @unique
  purpose                   String?
  linkedInvestmentAccountId String?
  linkedInvestmentAccount   BankAccount?    @relation("BankAccountInvestmentLink", fields: [linkedInvestmentAccountId], references: [id])
  linkedCurrentAccounts     BankAccount[]   @relation("BankAccountInvestmentLink")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  revenues                          Revenue[]
  payments                          Payment[]
  reconciliations                   BankReconciliation[]
  treasuryMovements                 TreasuryMovement[]
  transferOrigins                   TreasuryTransfer[]          @relation("TreasuryTransferOrigin")
  transferDestinations              TreasuryTransfer[]          @relation("TreasuryTransferDestination")
  statementImports                  BankStatementImport[]
  taxPayments                       TaxPayment[]
  taxFinancialMappings              TaxFinancialMapping[]
  constitutionalRevenueRules        ClassificationRule[]        @relation("ClassificationRuleBankAccount")
  statementItems                    BankStatementItem[]
  reconciliationSessions            BankReconciliationSession[]
  reconciliationAllocationGroups    BankReconciliationAllocationGroup[]
  covenants                         Covenant[]
  investmentAllocationsAsOrigin     InvestmentAllocation[]      @relation("InvestmentAllocationOrigin")
  investmentAllocationsAsInvestment InvestmentAllocation[]      @relation("InvestmentAllocationInvestment")
  educationFinancialAccounts        EducationFinancialAccount[]

  @@index([bankId])
  @@index([bankBranchId])
}

model BankAccountResourceSource {
  bankAccountId String
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  resourceSourceId String
  resourceSource ResourceSource @relation(fields: [resourceSourceId], references: [id], onDelete: Restrict)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([bankAccountId, resourceSourceId])
}

model TreasuryMovement {
  id                  String              @id @default(cuid())
  date                DateTime            @default(now())
  type                String
  direction           String
  valueDecimal        Decimal             @db.Decimal(18, 2)
  history             String?
  status              String              @default("Confirmado")
  bankAccountId       String
  bankAccount         BankAccount         @relation(fields: [bankAccountId], references: [id])
  resourceSourceId     String?
  resourceSource       ResourceSource? @relation(fields: [resourceSourceId], references: [id], onDelete: Restrict)
  financialYearId     String
  financialYear       FinancialYear       @relation(fields: [financialYearId], references: [id])
  revenueId           String?             @unique
  revenue             Revenue?            @relation(fields: [revenueId], references: [id])
  revenueReversal     RevenueReversal?
  sourceModule        String              @default("MANUAL")
  sourceType          String              @default("TREASURY_MOVEMENT")
  sourceId            String?
  eventType           String              @default("TREASURY_MOVEMENT")
  idempotencyKey      String?             @unique
  createdAt           DateTime            @default(now())
  transferOrigin      TreasuryTransfer?   @relation("TreasuryTransferOriginMovement")
  transferDestination TreasuryTransfer?   @relation("TreasuryTransferDestinationMovement")
  statementItems      BankStatementItem[]
  reconciliationAllocations BankReconciliationAllocation[]

  @@index([bankAccountId, date])
  @@index([bankAccountId, resourceSourceId, date])
  @@index([financialYearId, date])
}

model RevenueReversal {
  id                 String           @id @default(cuid())
  revenueId          String           @unique
  revenue            Revenue          @relation(fields: [revenueId], references: [id], onDelete: Restrict)
  date               DateTime
  valueDecimal       Decimal          @db.Decimal(18, 2)
  justification      String
  financialYearId    String
  financialYear      FinancialYear    @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  treasuryMovementId String           @unique
  treasuryMovement   TreasuryMovement @relation(fields: [treasuryMovementId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([financialYearId, date])
}

model RevenueResourceRedistribution {
  id                          String         @id @default(cuid())
  revenueId                   String
  revenue                     Revenue        @relation(fields: [revenueId], references: [id], onDelete: Restrict)
  date                        DateTime
  valueDecimal                Decimal        @db.Decimal(18, 2)
  sourceResourceSourceId      String
  sourceResourceSource        ResourceSource @relation("RevenueRedistributionSource", fields: [sourceResourceSourceId], references: [id], onDelete: Restrict)
  destinationResourceSourceId String
  destinationResourceSource   ResourceSource @relation("RevenueRedistributionDestination", fields: [destinationResourceSourceId], references: [id], onDelete: Restrict)
  financialYearId             String
  financialYear               FinancialYear  @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  history                     String
  idempotencyKey              String?        @unique
  createdAt                   DateTime       @default(now())

  @@index([revenueId, date])
  @@index([sourceResourceSourceId, destinationResourceSourceId])
}

model TreasuryTransfer {
  id                       String                @id @default(cuid())
  date                     DateTime              @default(now())
  valueDecimal             Decimal               @db.Decimal(18, 2)
  history                  String?
  sourceBankAccountId      String
  sourceBankAccount        BankAccount           @relation("TreasuryTransferOrigin", fields: [sourceBankAccountId], references: [id])
  destinationBankAccountId String
  destinationBankAccount   BankAccount           @relation("TreasuryTransferDestination", fields: [destinationBankAccountId], references: [id])
  sourceMovementId         String                @unique
  sourceMovement           TreasuryMovement      @relation("TreasuryTransferOriginMovement", fields: [sourceMovementId], references: [id])
  destinationMovementId    String                @unique
  destinationMovement      TreasuryMovement      @relation("TreasuryTransferDestinationMovement", fields: [destinationMovementId], references: [id])
  idempotencyKey           String?               @unique
  investmentAllocation     InvestmentAllocation?
  createdAt                DateTime              @default(now())
}

model BankStatementImport {
  id            String              @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])
