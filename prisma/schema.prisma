  usuarioId String @unique
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  personId String?
  person Person? @relation(fields: [personId], references: [id], onDelete: Restrict)
  companyId String?
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  grantedById String
  evidence String
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model PortalServiceVersion {
  id String @id @default(cuid())
  serviceId String
  service PortalServiceConfiguration @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  version Int
  snapshot Json
  createdById String
  createdAt DateTime @default(now())
  @@unique([serviceId, version])
}

model PortalServiceRequest {
  id String @id @default(cuid())
  serviceId String
  service PortalServiceConfiguration @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceVersion Int
  snapshot Json
  actorId String
  taxpayerId String?
  processId String @unique
  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)
  worksServiceId String? @unique
  executorType String @default("SOLICITACAO")
  executorId String?
  worksService ObrasServico? @relation(fields: [worksServiceId], references: [id], onDelete: Restrict)
  requestKey String
  inputHash String
  payload Json
  status String @default("RECEBIDO")
  revision Int @default(1)
  pendingDocumentCodes Json @default("[]")
  events PortalServiceRequestEvent[]
  uploads PortalServiceUpload[]
  schedules PortalScheduleRequest[]
  rating PortalServiceRating?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([actorId, requestKey])
  @@index([actorId, status, createdAt])
}

model PortalServiceRequestEvent {
  id String @id @default(cuid())
  requestId String
  request PortalServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actorId String
  kind String
  text String
  requestKey String
  inputHash String @default("")
  visible Boolean @default(true)
  documentVersionId String?
  createdAt DateTime @default(now())
  @@unique([requestId, requestKey])
}

model PortalServiceUpload {
  id String @id @default(cuid())
