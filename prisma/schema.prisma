  bankBalance          Float
  bankBalanceDecimal   Decimal?    @db.Decimal(18, 2)
  status               String      @default("Pendente") // Pendente, Conciliado, Divergente
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model InvestmentAllocation {
  id                      String            @id @default(cuid())
  originBankAccountId     String
  originBankAccount       BankAccount       @relation("InvestmentAllocationOrigin", fields: [originBankAccountId], references: [id])
  investmentBankAccountId String
  investmentBankAccount   BankAccount       @relation("InvestmentAllocationInvestment", fields: [investmentBankAccountId], references: [id])
