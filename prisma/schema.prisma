  fileName      String?
  checksum      String
  status        String              @default("Importado")
  importedAt    DateTime            @default(now())
  originalBytes Bytes?
  originalEncoding String?
  processingSnapshot Json?
  items         BankStatementItem[]

  @@unique([bankAccountId, checksum])
}

model BankStatementItem {
  id                 String               @id @default(cuid())
  bankAccountId      String?
  bankAccount        BankAccount?         @relation(fields: [bankAccountId], references: [id])
  statementImportId  String?
  statementImport    BankStatementImport? @relation(fields: [statementImportId], references: [id])
  date               DateTime
  description        String?
  reference          String?
  direction          String
  valueDecimal       Decimal              @db.Decimal(18, 2)
  status             String               @default("Pendente")
  treasuryMovementId String?              @unique
  treasuryMovement   TreasuryMovement?    @relation(fields: [treasuryMovementId], references: [id])
  reconciliationAllocations BankReconciliationAllocation[]

  // Campos adicionais para Automação POC, Rendimentos e Regras
  downloadId                  String?
  banco                       String?
  agencia                     String?
  contaNumero                 String?
  tipoConta                   String? // "CORRENTE" | "APLICACAO"
  codigoTransacao             String?
  sinal                       String? // "CREDITO" | "DEBITO"
  saldoResultanteDecimal      Decimal? @db.Decimal(18, 2)
  categoriaClassificada       String? // APLICACAO, RESGATE, TRANSFERENCIA_PARA_APLICACAO, etc.
  reciboMunicipal             String?
  lancamentoContabilId        String?
  bankTransactionId           String?
  integrationEventId          String?
  transactionType             String?
  clientReference             String?
  collectionReference         String?
  reversalOfBankTransactionId String?

  @@unique([banco, agencia, contaNumero, codigoTransacao])
  @@index([statementImportId, date])
  @@index([treasuryMovementId])
  @@index([downloadId])
  @@index([contaNumero, date])
  @@index([bankAccountId, bankTransactionId])
  @@index([integrationEventId])
}

model TaxFinancialMapping {
