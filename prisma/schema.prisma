model HealthSusFile {
  id                 String                     @id @default(cuid())
  fileType           String // BPA, FPO, RAAS, AIH, OUTRO
  competenceId       String
  competence         HealthProductionCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  unitId             String?
  unit               HealthUnit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  content            String
  hash               String
  quantity           Int
  totalValue         Decimal?                   @db.Decimal(14, 2)
  status             String                     @default("GERADO") // GERADO, PROCESSADO, PARCIAL, REJEITADO
  processedCount     Int                        @default(0)
  rejectedCount      Int                        @default(0)
  errors             Json?
  processedAt        DateTime?
  createdByUsuarioId String
  createdAt          DateTime                   @default(now())

  @@index([competenceId, fileType])
}

// --- Correção final POC B4: metas FPO e teto por unidade ---
model HealthProductionTarget {
  id                 String                     @id @default(cuid())
  competenceId       String
  competence         HealthProductionCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  procedureId        String
  procedure          HealthSusProcedure         @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  contractedQuantity Float
  createdByUsuarioId String
  createdAt          DateTime                   @default(now())

  @@unique([competenceId, procedureId])
}

model HealthUnitCeiling {
  id                 String     @id @default(cuid())
  unitId             String
  unit               HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  period             String // YYYY-MM
  value              Decimal    @db.Decimal(14, 2)
  createdByUsuarioId String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([unitId, period])
}

// --- Correção final POC B5: PA (recepção, risco configurável, leitos) ---
model HealthRiskProtocol {
  id             String   @id @default(cuid())
  level          Int      @unique // 1 (mais urgente) a 5
  label          String
  colorHex       String   @default("#64748b")
  maxWaitMinutes Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HealthDestination {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  receptions HealthReception[]
}

model HealthRoom {
  id        String     @id @default(cuid())
  unitId    String
  unit      HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  name      String
  kind      String     @default("Atendimento") // Atendimento, Triagem
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  receptions HealthReception[]

  @@unique([unitId, name])
}

model HealthReception {
  id                 String             @id @default(cuid())
  patientId          String?
  patient            Patient?           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  unidentifiedName   String?
  unitId             String
  unit               HealthUnit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  arrivalAt          DateTime           @default(now())
  priorityFlags      String? // GESTANTE, IDOSO, DEFICIENTE (vírgula)
  companionName      String?
  companionKinship   String?
  companionPhone     String?
  transportMode      String? // Meios próprios, Socorro
  agreement          String?
  roomId             String?
  room               HealthRoom?        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  destinationId      String?
  destination        HealthDestination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  status             String             @default("Aguardando") // Aguardando, Em atendimento, Concluída, Evadiu-se, Cancelada
  outcome            String?
  createdByUsuarioId String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([unitId, status, arrivalAt])
  @@index([patientId])
}

model HealthBed {
  id        String     @id @default(cuid())
  unitId    String
  unit      HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  room      String?
  code      String
  status    String     @default("Livre") // Livre, Ocupado, Manutenção, Reservado, Limpeza
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  occupancies        HealthBedOccupancy[]
  healthObservations HealthObservation[]

  @@unique([unitId, code])
  @@index([unitId, status])
}

model HealthBedOccupancy {
  id           String    @id @default(cuid())
  bedId        String
  bed          HealthBed @relation(fields: [bedId], references: [id], onDelete: Restrict)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admittedAt   DateTime  @default(now())
  dischargedAt DateTime?
  notes        String?

  @@index([bedId, dischargedAt])
  @@index([patientId])
}

model HealthObservation {
  id                 String     @id @default(cuid())
  medicalRecordId    String?    @unique
  medicalRecord      MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  patientId          String
  patient            Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  unitId             String
  unit               HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  bedId              String?
  bed                HealthBed? @relation(fields: [bedId], references: [id], onDelete: Restrict)
  responsible        String?
  solicitedBy        String?
  status             String     @default("Em observação") // Em observação, Alta, Transferido
  admittedAt         DateTime   @default(now())
  dischargedAt       DateTime?
  createdByUsuarioId String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([unitId, status])
}

// --- Correção final POC B6: regulação (setores, protocolo, anexos, convênios) ---
model HealthRegulationSector {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  requests HealthRegulationRequest[]
}

model HealthRegulationAttachment {
  id                  String                  @id @default(cuid())
  requestId           String
  request             HealthRegulationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentId          String
  document            Document                @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedByUsuarioId String
  createdAt           DateTime                @default(now())

  @@index([requestId])
}

model HealthTfdPassengerRemoval {
  id                   String             @id @default(cuid())
  passengerId          String             @unique
  passenger            HealthTfdPassenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  requestedByUsuarioId String
  confirmedByUsuarioId String?
  status               String             @default("Pendente") // Pendente, Confirmada, Cancelada
  createdAt            DateTime           @default(now())
}

// --- S4-D: Territorio, SISAB e e-SUS ---
model HealthTerritoryArea {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  unitId    String?
  unit      HealthUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  teamId    String?
  team      HealthTeam? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  microareas HealthMicroarea[]
  visits     HealthHomeVisit[]

  @@index([unitId, isActive])
}

model HealthMicroarea {
  id                  String              @id @default(cuid())
  code                String
  areaId              String
  area                HealthTerritoryArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  agentProfessionalId String?
  agentProfessional   HealthProfessional? @relation(fields: [agentProfessionalId], references: [id], onDelete: Restrict)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())

  households HealthHousehold[]
  visits     HealthHomeVisit[]

  @@unique([areaId, code])
}

model HealthHousehold {
  housingDetails Json?
  id            String           @id @default(cuid())
  householdCode String?          @unique
  microareaId   String?
  microarea     HealthMicroarea? @relation(fields: [microareaId], references: [id], onDelete: Restrict)
  addressId     String?
  address       Address?         @relation(fields: [addressId], references: [id], onDelete: Restrict)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  families HealthFamily[]
  visits   HealthHomeVisit[]
  forms    HealthEsusForm[]
}

model HealthFamily {
  classification String?
  familyType String?
  unitId String?
  teamId String?
  events HealthFamilyEvent[]
  id                  String           @id @default(cuid())
  familyCode          String?
  householdId         String?
  household           HealthHousehold? @relation(fields: [householdId], references: [id], onDelete: Restrict)
  responsiblePersonId String?
  responsiblePerson   Person?          @relation(fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  masterFamilyId      String?          @unique
  masterFamily        Family?          @relation(fields: [masterFamilyId], references: [id], onDelete: Restrict)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  members HealthFamilyMember[]
  visits  HealthHomeVisit[]
  forms   HealthEsusForm[]

  @@index([householdId, isActive])
}

model HealthFamilyMember {
  id        String       @id @default(cuid())
  familyId  String
  family    HealthFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  personId  String       @unique
  person    Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  kinship   String?
  createdAt DateTime     @default(now())

  @@index([familyId])
}

model HealthHomeVisit {
  unitId String?
  unit HealthUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  id                 String               @id @default(cuid())
  householdId        String?
  household          HealthHousehold?     @relation(fields: [householdId], references: [id], onDelete: Restrict)
  familyId           String?
  family             HealthFamily?        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  teamId             String?
  team               HealthTeam?          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  professionalId     String
  professional       HealthProfessional   @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  areaId             String?
  area               HealthTerritoryArea? @relation(fields: [areaId], references: [id], onDelete: Restrict)
  microareaId        String?
  microarea          HealthMicroarea?     @relation(fields: [microareaId], references: [id], onDelete: Restrict)
  visitedAt          DateTime
  actions            String
  observations       String?
  status             String               @default("REALIZADA") // REALIZADA, CANCELADA
  createdByUsuarioId String
  createdAt          DateTime             @default(now())

  participants HealthHomeVisitParticipant[]

  @@index([visitedAt, status])
  @@index([familyId, visitedAt])
}

model HealthHomeVisitParticipant {
  outcome String @default("PRESENT")
  refusalReason String?
  weight Float?
  height Float?
  bloodPressure String?
  temperature Float?
  heartRate Int?
  bloodGlucose Float?
  id        String          @id @default(cuid())
  visitId   String
  visit     HealthHomeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  personId  String
  person    Person          @relation(fields: [personId], references: [id], onDelete: Restrict)
  patientId String?
  patient   Patient?        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())

  @@unique([visitId, personId])
}

model HealthEsusForm {
  id                    String              @id @default(cuid())
  kind                  String // INDIVIDUAL, DOMICILIAR, VISITA, ATENDIMENTO_INDIVIDUAL, ODONTO, ATIVIDADE_COLETIVA, PROCEDIMENTOS, CONSUMO_ALIMENTAR, ATENDIMENTO_DOMICILIAR, OUTRO
  householdId           String?
  household             HealthHousehold?    @relation(fields: [householdId], references: [id], onDelete: Restrict)
  familyId              String?
  family                HealthFamily?       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  personId              String?
  person                Person?             @relation(fields: [personId], references: [id], onDelete: Restrict)
  patientId             String?
  patient               Patient?            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professionalId        String?
  professional          HealthProfessional? @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  teamId                String?
  team                  HealthTeam?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  unitId                String?
  unit                  HealthUnit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  period                String // YYYY-MM
  status                String              @default("RASCUNHO") // RASCUNHO, FINALIZADA
  payload               Json?
  originMedicalRecordId String?
  originMedicalRecord   MedicalRecord?      @relation(fields: [originMedicalRecordId], references: [id], onDelete: Restrict)
  idempotencyKey        String              @unique
  finalizedAt           DateTime?
  createdByUsuarioId    String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  batchItems HealthEsusBatchItem[]

  @@index([kind, period, status])
  @@index([unitId, period])
}

model HealthFamilyEvent {
  id String @id @default(cuid())
  familyId String
  family HealthFamily @relation(fields: [familyId], references: [id], onDelete: Restrict)
  eventType String
  personId String?
  effectiveAt DateTime
  reason String
  snapshot Json
  actorUsuarioId String
  createdAt DateTime @default(now())
  @@index([familyId, effectiveAt])
}

model HealthFamilyDocument {
  id String @id @default(cuid())
  familyId String
  family Family @relation(fields: [familyId], references: [id], onDelete: Restrict)
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  actorUsuarioId String
  createdAt DateTime @default(now())
  @@unique([familyId, documentId])
}

model HealthHomeCareRequest {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  unitId String
  requestedAt DateTime
  reason String
  status String @default("REQUESTED")
  createdByUsuarioId String
  assessments HealthHomeCareAssessment[]
  attendances HealthHomeCareAttendance[]
  createdAt DateTime @default(now())
  @@index([unitId, status])
}

model HealthHomeCareAssessment {
  id String @id @default(cuid())
  requestId String
  request HealthHomeCareRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  assessedAt DateTime
  professionalId String
  eligible Boolean
  modality String
  cidReferenceId String?
  character String
  evaluation String
  actorUsuarioId String
  attendances HealthHomeCareAttendance[]
  createdAt DateTime @default(now())
}

model HealthHomeCareAttendance {
  id String @id @default(cuid())
  requestId String
  request HealthHomeCareRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  assessmentId String
  assessment HealthHomeCareAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  medicalRecordId String @unique
  performedAt DateTime
  actorUsuarioId String
  createdAt DateTime @default(now())
}

model HealthCollectiveActivity {
  teamSnapshot Json?
  id String @id @default(cuid())
  unitId String
  teamId String
  professionalId String
  occurredAt DateTime
  activityType String
  themes String[]
  practices String[]
  participantIds String[]
  procedureId String?
  notes String?
  createdByUsuarioId String
  createdAt DateTime @default(now())
  @@index([unitId, occurredAt])
}

model HealthFoodMarker {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  unitId String
  professionalId String
  recordedAt DateTime
  ageGroup String
  place String
  markers Json
  actorUsuarioId String
  createdAt DateTime @default(now())
  @@index([patientId, recordedAt])
}

model HealthEsusBatch {
  id                 String    @id @default(cuid())
  competence         String // YYYY-MM
  status             String    @default("GERADO") // GERADO, PROCESSANDO, ACEITO, PARCIAL, REJEITADO
  fileContent        String
  hash               String
  total              Int
  accepted           Int       @default(0)
  rejected           Int       @default(0)
  errors             Json?
  processedAt        DateTime?
  createdByUsuarioId String
  createdAt          DateTime  @default(now())

  items HealthEsusBatchItem[]

  @@index([competence, status])
}

model HealthEsusBatchItem {
  id        String          @id @default(cuid())
  batchId   String
  batch     HealthEsusBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  formId    String
  form      HealthEsusForm  @relation(fields: [formId], references: [id], onDelete: Restrict)
  status    String          @default("PENDENTE") // PENDENTE, ACEITO, REJEITADO
  message   String?
  createdAt DateTime        @default(now())

  @@unique([batchId, formId])
}

// --- Correção final POC: Agenda (cronogramas, vagas, espera) ---
model HealthCareSchedule {
  agreementId String?
  agreement HealthCareAgreement? @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  procedureId String?
  locationUnitId String?
  validFrom DateTime?
  validUntil DateTime?
  genderRestriction String?
  minAge Int?
  maxAge Int?
  allowHolidays Boolean @default(false)
  requirePresenceConfirmation Boolean @default(false)
  releaseAbsenceSlot Boolean @default(true)
  fixedReceiptTime String?
  slotMinutes Int @default(15)
  blocks HealthScheduleBlock[]
  id                 String                 @id @default(cuid())
  kind               String                 @default("FIXO") // FIXO, DIARIO
  unitId             String
  unit               HealthUnit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  specialtyId        String?
  specialty          HealthSpecialty?       @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  professionalId     String?
  professional       HealthProfessional?    @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  groupId            String?
  group              HealthSchedulingGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  providerSupplierId String?
  provider           Supplier?              @relation(fields: [providerSupplierId], references: [id], onDelete: Restrict)
  weekday            Int?
  date               DateTime?              @db.Date
  startTime          String?
  endTime            String?
  totalSlots         Int                    @default(1)
  status             String                 @default("Ativo") // Ativo, Bloqueado, Cancelado
  blockReason        String?
  createdByUsuarioId String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  appointments HealthAppointment[]
  waitlist     HealthWaitlist[]

  @@index([unitId, status])
  @@index([professionalId, date])
  @@index([kind, status])
}

model HealthWaitlist {
  events HealthWaitlistEvent[]
  unitId String?
  procedureId String?
  programName String?
  regulationRequestId String? @unique
  regulationRequest HealthRegulationRequest? @relation(fields: [regulationRequestId], references: [id], onDelete: Restrict)
  appointmentId String? @unique
  appointment HealthAppointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  id                 String              @id @default(cuid())
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  specialtyId        String?
  specialty          HealthSpecialty?    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  scheduleId         String?
  schedule           HealthCareSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  priority           String              @default("Normal") // Normal, Prioridade, Urgência
  status             String              @default("Aguardando") // Aguardando, Chamado, Convertido, Cancelado
  notes              String?
  createdByUsuarioId String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, priority, createdAt])
  @@index([patientId, status])
}

// --- S5: Portal do Prestador e Vigilância em Saúde ---
model HealthWaitlistEvent {
  id String @id @default(cuid())
  waitlistId String
  waitlist HealthWaitlist @relation(fields: [waitlistId], references: [id], onDelete: Restrict)
  eventType String
  fromStatus String?
  toStatus String
  notes String?
  appointmentId String?
  appointment HealthAppointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  actorUsuarioId String
  createdAt DateTime @default(now())

  @@index([waitlistId, createdAt])
}

// --- S5: Portal do Prestador e Vigilância em Saúde ---
model HealthScheduleBlock {
  id String @id @default(cuid())
  scheduleId String
  schedule HealthCareSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  startsAt DateTime
  endsAt DateTime
  reason String
  actorUsuarioId String
  createdAt DateTime @default(now())
  @@index([scheduleId, startsAt, endsAt])
}

model HealthRegulationReview {
  id String @id @default(cuid())
  requestId String
  request HealthRegulationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  step String
  decision String
  priority String
  notes String
  professionalId String?
  actorUsuarioId String
  createdAt DateTime @default(now())
  @@index([requestId, createdAt])
}

model HealthCallPanel {
  id String @id @default(cuid())
  unitId String
  sector String
  title String
  callMessage String
  news String
  isActive Boolean @default(true)
  calls HealthPanelCall[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([unitId, sector])
}

model HealthPanelCall {
  id String @id @default(cuid())
  panelId String
  panel HealthCallPanel @relation(fields: [panelId], references: [id], onDelete: Restrict)
  patientId String
  appointmentId String?
  pharmacyRequestId String?
  message String
  actorUsuarioId String
  calledAt DateTime @default(now())
  @@index([panelId, calledAt])
}

model HealthProviderAccess {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, usuarioId])
  @@index([usuarioId, isActive])
}

model HealthVigilanceEstablishment {
  id        String   @id @default(cuid())
  name      String
  document  String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Restrict)
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: Restrict)
  cnae      String?
  activity  String?
  riskLevel String? // Classificação de risco configurada; nunca inferida automaticamente
  status    String   @default("Ativo") // Ativo, Inativo, Interditado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints  HealthVigilanceComplaint[]
  inspections HealthVigilanceInspection[]
  licenses    HealthVigilanceLicense[]

  @@index([status])
  @@index([cnae])
}

model HealthVigilanceComplaint {
  id               String                        @id @default(cuid())
  establishmentId  String?
  establishment    HealthVigilanceEstablishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  place            String?
  description      String
  isAnonymous      Boolean                       @default(true)
  reporterPersonId String?
  reporterPerson   Person?                       @relation(fields: [reporterPersonId], references: [id], onDelete: Restrict)
  status           String                        @default("Recebida") // Recebida, Em apuração, Encerrada
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  inspections HealthVigilanceInspection[]

  @@index([status, createdAt])
}

model HealthVigilanceInspection {
  id                 String                       @id @default(cuid())
  establishmentId    String
  establishment      HealthVigilanceEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  complaintId        String?
  complaint          HealthVigilanceComplaint?    @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  professionalId     String?
  professional       HealthProfessional?          @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  inspectedAt        DateTime
  reason             String?
  findings           String?
  status             String                       @default("Agendada") // Agendada, Realizada, Com pendências, Encerrada
  createdByUsuarioId String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  items HealthVigilanceInspectionItem[]

  @@index([establishmentId, inspectedAt])
  @@index([status])
}

model HealthVigilanceInspectionItem {
  id           String                    @id @default(cuid())
  inspectionId String
  inspection   HealthVigilanceInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
