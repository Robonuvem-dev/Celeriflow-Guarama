// Cross-cutting, payload-free evidence for successful authenticated operations.
// The database trigger created by the migration makes these records append-only.
model AuditEvent {
  id             String   @id @default(cuid())
  eventType      String
  targetType     String
  targetId       String
  actorUsuarioId String
  actorUsuario   Usuario  @relation("AuditEventActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)
