  id              String                  @id @default(cuid())
  agreementId     String
  agreement       TaxInstallmentAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  quotaNumber     Int
  dueDate         DateTime
  originalDecimal Decimal                 @db.Decimal(18, 2)
  paidDecimal     Decimal                 @default(0) @db.Decimal(18, 2)
  balanceDecimal  Decimal                 @db.Decimal(18, 2)
  status          String                  @default("ABERTA")
  guideId         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  allocations TaxInstallmentPaymentAllocation[]

  @@unique([agreementId, quotaNumber])
  @@index([dueDate, status])
}

model TaxInstallmentPaymentAllocation {
  id            String                  @id @default(cuid())
  agreementId   String
  agreement     TaxInstallmentAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  quotaId       String
  quota         TaxInstallmentQuota     @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  paymentKey    String
  amountDecimal Decimal                 @db.Decimal(18, 2)
  paymentDate   DateTime
  paymentMode   String                  @default("FORA_DA_PARCELA")
  createdAt     DateTime                @default(now())

  @@unique([paymentKey, quotaId])
  @@index([agreementId, paymentDate])
}

model TaxInstallmentEvent {
  id             String                  @id @default(cuid())
  agreementId    String
  agreement      TaxInstallmentAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  eventType      String
  description    String
  payload        Json?
  actorUsuarioId String?
  createdAt      DateTime                @default(now())

  @@index([agreementId, createdAt])
}

model TaxpayerPortalAccess {
  id                 String    @id @default(cuid())
  usuarioId          String
  taxpayerId         String
  accessType         String    @default("TITULAR")
  scopes             Json
  status             String    @default("ATIVO")
  grantedByUsuarioId String
  grantedAt          DateTime  @default(now())
  revokedAt          DateTime?

  @@unique([usuarioId, taxpayerId])
  @@index([taxpayerId, status])
}

// Explicit authorization to the external status projection, never to internal documents.
model ProcessCitizenAccess {
  id                 String @id @default(cuid())
  processId          String
  process            Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  usuarioId          String
  usuario            Usuario @relation("CitizenProcessViewer", fields: [usuarioId], references: [id], onDelete: Cascade)
  grantedByUsuarioId String
  grantedBy          Usuario @relation("CitizenProcessGrantor", fields: [grantedByUsuarioId], references: [id], onDelete: Restrict)
  reason             String
  grantedAt          DateTime @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?

  @@unique([processId, usuarioId])
  @@index([usuarioId, revokedAt, expiresAt])
}

model PortalServiceConfiguration {
