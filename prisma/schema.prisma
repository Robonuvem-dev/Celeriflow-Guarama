  healthFamilyDocuments HealthFamilyDocument[]
  healthPatientDocuments HealthPatientDocument[]
  planningDocumentLinks PlanningDocumentLink[]
  constructionEnforcementEvidence ConstructionEnforcementEvidence[]
  id              String         @id @default(cuid())
  sstCertificateDocument SstCertificateDocument?
  title           String
  documentType    String // RG, CPF, CNPJ, Contrato, Comprovante
