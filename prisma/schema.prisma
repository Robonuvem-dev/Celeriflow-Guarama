  reversalBankTransactionId   String?     @unique
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  retentions                PaymentRetention[]
  financialDocument         FinancialDocument?         @relation("FinancialDocumentPayment")
  payableCarryForwardEvents PayableCarryForwardEvent[]
  instrumentInstallments    InstrumentInstallment[]    @relation("InstrumentInstallmentPayment")

  @@index([bankAccountExternalId, bankStatus])
  @@index([payableCarryForwardId, status])
}

// Registros internos emitidos pelo sistema; nÃ£o dependem de arquivo GED ou assinatura externa.
model FinancialDocument {
  id                   String   @id @default(cuid())
  documentType         String
  number               String   @unique
  title                String
  source               String   @default("SYSTEM")
  generatedByUsuarioId String
  snapshot             Json
  generatedAt          DateTime @default(now())

  commitmentId         String?
