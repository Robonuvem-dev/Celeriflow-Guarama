  payableCarryForwardId       String?
  payableCarryForward         PayableCarryForward? @relation("NativeCarryForwardPayments", fields: [payableCarryForwardId], references: [id], onDelete: Restrict)
  bankAccountId               String
  bankAccount                 BankAccount @relation(fields: [bankAccountId], references: [id])
  supplierId                  String
  supplier                    Supplier    @relation("SupplierPayments", fields: [supplierId], references: [id])
  creditorId                  String?
  creditor                    Creditor?   @relation(fields: [creditorId], references: [id])
