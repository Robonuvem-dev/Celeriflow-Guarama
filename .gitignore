# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.agent/
docs/doc_extracted/
docs/doc.zip

# Local document archive exceeds GitHub's per-file limit.
/docs/Novos docs.zip
/docs/Novos docs/Novos docs/LEI Nº 687-2025 - PPA 2026-2029.zip

/src/generated/prisma
/src/generated/platform-prisma

# Keep project JSON configuration and shared development data versioned.
# Environment files are excluded above, with .env.example intentionally allowed.
