# Neon PostgreSQL
# Use the pooled URL at runtime and the direct URL for Prisma migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Firebase Authentication - client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Authentication - Admin SDK service account
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# CeleriFlow Ibema
CELERIFLOW_INSTANCE_ID=ibema
CELERIFLOW_PUBLIC_BASE_URL=
SYSTEM_ADMIN_EMAIL=celeriflow@gmail.com
SYSTEM_ADMIN_NAME=CeleriFlow
NEXT_PUBLIC_POC_MODE=false
CELERIFLOW_ACCOUNTING_MODE=
STRICT_SEGREGATION=true

# Application secrets and scheduled jobs
CRON_SECRET=
PROTOCOLS_CRON_SECRET=
PRICE_RESEARCH_PORTAL_SECRET=
NFSE_WEBSERVICE_TOKEN=
DESIF_WEBSERVICE_TOKEN=

# Optional bank integration
BANK_SANDBOX_BASE_URL=
BANK_SANDBOX_CLIENT_ID=
BANK_SANDBOX_CLIENT_SECRET=
BANK_SANDBOX_STATEMENT_FORMAT=ofx
BANK_SANDBOX_TIMEOUT_MS=15000
BANK_SANDBOX_RETRY_LIMIT=2
BANK_SYNC_SECRET=
SIMULADOR_WEBHOOK_SECRET=

# A1 secret-provider example. Register only the prefix (IBEMA_A1) in the UI.
# Public certificate and trust chain are stored in the certificate inventory;
# private key material remains exclusively in protected server environment variables.
IBEMA_A1_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
IBEMA_A1_PRIVATE_KEY_PASSPHRASE=
